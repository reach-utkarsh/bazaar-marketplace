# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
# Public base URL of this API (used to build absolute upload URLs)
PUBLIC_API_URL=http://localhost:4000

# ---- Database (docker compose maps Postgres to host port 5440) ----
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5440/marketplace?schema=public
# Used by `npm test` (separate database, reset by the test suite)
TEST_DATABASE_URL=postgresql://marketplace:marketplace@localhost:5440/marketplace_test?schema=public

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ---- Payments: Razorpay TEST mode ----
# Leave these blank to use the built-in MOCK payment provider.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Minutes before an unpaid order is expired and its stock released
PAYMENT_EXPIRY_MINUTES=30

# ---- Commission ----
# Default platform commission in basis points (1000 = 10%). Admin can change it at runtime.
DEFAULT_COMMISSION_BPS=1000

# ---- Storage ----
# "local" (disk, served from /uploads). A Cloudinary adapter can be plugged in via StorageService.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Rate limiting (requests per window per IP on /api/auth) ----
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
